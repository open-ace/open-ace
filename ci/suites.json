{
  "version": 1,
  "baseline_runbook": "docs/TEST_LAYERS.md#baseline",
  "toolchain": {
    "production_python": "3.11",
    "compatibility_python": ["3.10", "3.14"],
    "node": "20",
    "runner": "ubuntu-24.04"
  },
  "pr_suites": [
    "compatibility-smoke",
    "critical-e2e",
    "default-collection",
    "dependency-audit",
    "frontend",
    "issue-collection",
    "legacy-pr",
    "package",
    "postgres",
    "python-core"
  ],
  "suites": {
    "default-collection": {
      "description": "Required collection and baseline gate for default pytest discovery",
      "timeout_seconds": 120,
      "collection_target": "tests",
      "baseline_layer": "default"
    },
    "dependency-audit": {
      "description": "Audit declared Python and locked frontend production dependencies",
      "timeout_seconds": 300,
      "commands": [
        ["{python}", "-m", "pip_audit", "-r", "requirements-ci.lock", "--skip-editable"],
        {
          "working_directory": "frontend",
          "command": ["npm", "ci", "--no-audit", "--no-fund"]
        },
        {
          "working_directory": "frontend",
          "command": ["bash", "../scripts/ci/npm_audit_with_whitelist.sh"]
        }
      ]
    },
    "python-core": {
      "description": "Required deterministic Python suite on the production runtime",
      "timeout_seconds": 420,
      "commands": [
        ["{python}", "-m", "pytest", "tests/", "-q", "--maxfail=1", "--cov=scripts/shared", "--cov=app/auth", "--cov=app/remote_ws_handler", "--cov=app/modules/sso", "--cov-fail-under=30", "--cov-report=xml", "-m", "not postgres and not performance"],
        ["{python}", "scripts/scan_test_false_positives.py", "tests", "--exclude-dirs", "tests/issues", "--baseline", ".false-positive-baseline.json"]
      ]
    },
    "compatibility-smoke": {
      "description": "Fast minimum/maximum Python compatibility coverage",
      "timeout_seconds": 360,
      "commands": [
        ["{python}", "-m", "compileall", "-q", "app", "scripts", "cli.py", "server.py"],
        ["{python}", "-m", "pytest", "tests/unit/", "-q", "--maxfail=1", "-m", "not performance"]
      ]
    },
    "issue-collection": {
      "description": "Required collection and baseline gate for the legacy issue quarantine",
      "timeout_seconds": 120,
      "collection_target": "tests/issues",
      "baseline_layer": "issues"
    },
    "legacy-pr": {
      "description": "Required legacy regressions promoted before Issue #2429",
      "timeout_seconds": 300,
      "commands": [
        ["{python}", "-m", "pytest", "tests/issues", "-q", "--maxfail=1", "-m", "priority_p0 and not postgres and not performance"]
      ]
    },
    "frontend": {
      "description": "Frontend lint, typecheck, unit tests, and production build",
      "timeout_seconds": 480,
      "working_directory": "frontend",
      "commands": [
        ["npm", "ci", "--no-audit", "--no-fund"],
        ["npm", "run", "lint"],
        ["npm", "run", "format:check"],
        ["npm", "run", "typecheck"],
        ["npm", "run", "test:coverage"],
        ["npm", "run", "build"]
      ]
    },
    "package": {
      "description": "Build Python source and wheel artifacts",
      "timeout_seconds": 240,
      "commands": [
        ["{python}", "-m", "build", "--sdist", "--wheel", "--outdir", "dist/"]
      ]
    },
    "postgres": {
      "description": "PostgreSQL integration suite; requires the CI postgres service",
      "timeout_seconds": 480,
      "preserve_database_environment": true,
      "commands": [
        ["{python}", "-m", "pytest", "tests/integration", "-q", "--maxfail=1", "-m", "postgres"]
      ]
    },
    "performance": {
      "description": "Wall-clock benchmarks; advisory because shared runners are noisy",
      "timeout_seconds": 900,
      "commands": [
        ["{python}", "-m", "pytest", "tests", "-q", "--maxfail=1", "-m", "performance and not postgres"]
      ]
    },
    "critical-e2e": {
      "description": "Change-sensitive critical browser path; not required until stabilized",
      "timeout_seconds": 480,
      "commands": [
        ["{python}", "scripts/run_extended_tests.py", "--category", "critical", "--isolated-home", "--reruns", "1", "--timeout", "180", "--maxfail", "5"]
      ]
    }
  }
}
