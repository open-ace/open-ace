#!/bin/bash
# openace-fetch-wrapper - 安全采集包装器
#
# 用于以 root 权限读取权限 700 的用户 home 目录下的工具数据，
# 然后降权传递给 fetch 脚本进行解析和数据库写入。
#
# 安全特性：
# 1. 参数精确匹配白名单（使用参数分离验证）
# 2. 工具名称白名单校验（支持 fetch_* 下划线格式）
# 3. 符号链接攻击防护（多层解析、循环检测、路径白名单）
# 4. 审计日志记录（caller 恒脱敏；details 中单层 home 段脱敏——
#    非加密保护，低熵用户名可字典逆推哈希，见 _username_hash 注释）
# 5. 降权机制（root 读取，openace 写入）
# 6. 路径规范化防遍历攻击（使用 readlink -f）
# 7. 参数重复检测和参数值边界校验
#
# 存放位置：/usr/local/bin/openace-fetch-wrapper
# 权限：root:root, 755
#
# 平台支持：Linux (readlink -f 来自 GNU coreutils)
# 不支持平台：macOS (BSD readlink 不支持 -f 参数)
#
# Issue #2543: 本地工作区会话数据采集权限修复
# Issue #3249: 参数校验下划线修复和安全加固

set -euo pipefail

# ============================================================================
# 配置常量
# ============================================================================

# 审计日志配置
AUDIT_LOG="${AUDIT_LOG:-/var/log/openace/fetch-audit.log}"

# 配置文件默认路径
DEFAULT_CONFIG="/etc/openace/config.json"

# 符号链接解析最大深度
MAX_SYMLINK_DEPTH=10

# 单文件大小限制（字节），50MB
MAX_FILE_SIZE=$((50 * 1024 * 1024))

# 降权运行的目标用户
RUN_USER="${RUN_USER:-openace}"

# ============================================================================
# 参数白名单（精确匹配，无通配符）
# ============================================================================

# 定义允许的工具名称
declare -a ALLOWED_TOOLS=(
    "fetch_qwen"
    "fetch_claude"
    "fetch_zcode"
    "fetch_codex"
    "fetch_openclaw"
)

# 工具名称到目录名的映射
declare -A TOOL_TO_DIR=(
    ["fetch_qwen"]=".qwen"
    ["fetch_claude"]=".claude"
    ["fetch_zcode"]=".zcode"
    ["fetch_codex"]=".codex"
    ["fetch_openclaw"]=".openclaw"
)

# ============================================================================
# 辅助函数
# ============================================================================

# 记录审计日志（#3292：caller 恒脱敏；details 过 sanitize_details，
# 对白名单校验过的单层 home 形状保证脱敏——边界见该函数注释）
log_audit() {
    local action="$1"
    local details="$2"
    local timestamp
    timestamp=$(date -Iseconds 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S%z')
    local caller
    caller=$(sanitize_username "${SUDO_USER:-${USER:-unknown}}")

    # 确保日志目录存在
    mkdir -p "$(dirname "$AUDIT_LOG")" 2>/dev/null || true

    # 写入审计日志
    echo "${timestamp} | caller=${caller} | action=${action} | $(sanitize_details "$details")" >> "$AUDIT_LOG" 2>/dev/null || true
}

# 用户名短哈希（sha256 前 8 位 hex）
# 用途是关联而非加密：同一用户跨日志条目可关联，但用户名低熵、
# 截断哈希可被字典逆推，不提供机密性保证。
_username_hash() {
    local name="$1"
    local out=""
    # 条件位置的命令替换失败不触发 errexit；sha256sum 缺失（如 macOS）回退 shasum
    if out=$(printf '%s' "$name" | sha256sum 2>/dev/null); then
        :
    elif out=$(printf '%s' "$name" | shasum -a 256 2>/dev/null); then
        :
    else
        out=""
    fi
    # 输出形如 "<64位hex>  -"，取前 8 位；工具缺失/输出异常时退化为 unknown
    local hex="${out:0:8}"
    if [[ ! "$hex" =~ ^[0-9a-f]{8}$ ]]; then
        echo "unknown"
    else
        echo "$hex"
    fi
}

# 脱敏用户名：首字母 + *** + 截断哈希（如 alice -> a***-<hash8>）
# 单字符名不保留首字母（泄首字母即泄全名），只留 *** + 哈希。
sanitize_username() {
    local username="$1"
    if [ ${#username} -le 1 ]; then
        echo "***-$(_username_hash "$username")"
    else
        echo "${username:0:1}***-$(_username_hash "$username")"
    fi
}

# details 内 home 路径用户名段脱敏（#3292）
# 将 /home/<name>/ 与 /Users/<name>/ 中的用户名段替换为 sanitize_username
# 结果。终止性：脱敏产物含 '*'，不满足 [a-zA-Z0-9_-]+ 段匹配，不会再
# 次命中；对已脱敏输入幂等。
# 覆盖边界（如实声明）：参数白名单（validate_config_path 等）只放行单层
# home 形状，本函数对这类形状保证脱敏。但 validate_args 对 `--` 之后的
# 参数不做校验（既有行为，独立跟进），post-`--` 内容可绕过白名单进入
# details——对其中不匹配 ^/home|/Users/<name>/ 形状的用户名（无尾斜杠、
# 含非法字符、嵌套段、超过 guard 上限的多次出现）本函数不保证脱敏。
sanitize_details() {
    local details="$1"
    local re='(/(home|Users)/)([a-zA-Z0-9_-]+)/'
    # 防御性上限：校验过的参数面（单个 --config、拒绝重复）远小于 20 段；
    # post-`--` 内容可人为超过（见上），届时 20 名之后的段保持原样
    local guard=0
    while [[ "$details" =~ $re && $guard -lt 20 ]]; do
        local prefix="${BASH_REMATCH[1]}"
        local name="${BASH_REMATCH[3]}"
        local seg="${prefix}${name}/"
        local rep="${prefix}$(sanitize_username "$name")/"
        details="${details//$seg/$rep}"
        guard=$((guard + 1))
    done
    printf '%s' "$details"
}

# 验证工具名称是否在白名单内
# Issue #3249: 缩短错误信息，避免泄露敏感信息
validate_tool() {
    local tool="$1"
    local allowed

    for allowed in "${ALLOWED_TOOLS[@]}"; do
        if [ "$tool" = "$allowed" ]; then
            return 0
        fi
    done

    echo "ERROR: Invalid tool" >&2
    return 1
}

# ============================================================================
# 参数值校验函数
# Issue #3249: 新增参数值边界校验
# ============================================================================

# 校验参数值非空且安全
validate_arg_value() {
    local arg_name="$1"
    local value="$2"

    # 参数值不能为空
    if [[ -z "$value" ]]; then
        echo "ERROR: $arg_name requires a value" >&2
        return 1
    fi

    # 参数值不能以 - 开头（防止伪造参数）
    if [[ "${value:0:1}" == "-" ]]; then
        echo "ERROR: $arg_name value cannot start with '-'" >&2
        return 1
    fi

    # 拒绝 shell 元字符
    # 分号、管道、&、$、反引号、括号、重定向、history expansion、换行
    if [[ "$value" == *";"* ]] || [[ "$value" == *"|"* ]] || \
       [[ "$value" == *"&"* ]] || [[ "$value" == *"$"* ]] || \
       [[ "$value" == *\`* ]] || [[ "$value" == *"("* ]] || \
       [[ "$value" == *")"* ]] || [[ "$value" == *"!"* ]] || \
       [[ "$value" == *"<"* ]] || [[ "$value" == *">"* ]] || \
       [[ "$value" =~ $'\n' ]] || [[ "$value" =~ $'\r' ]]; then
        echo "ERROR: Invalid characters in $arg_name value" >&2
        return 1
    fi

    return 0
}

# 校验 --days 参数值
validate_days() {
    local value="${1:-}"

    if ! [[ "$value" =~ ^[0-9]+$ ]]; then
        echo "ERROR: Invalid --days value" >&2
        return 1
    fi

    if [[ "$value" -lt 1 ]] || [[ "$value" -gt 365 ]]; then
        echo "ERROR: Invalid --days value (must be 1-365)" >&2
        return 1
    fi

    return 0
}

# 校验 --mode 参数值
# Issue #3249: 新增 --mode 参数校验
validate_mode() {
    local value="${1:-}"

    if [[ "$value" != "both" ]] && \
       [[ "$value" != "usage" ]] && \
       [[ "$value" != "messages" ]]; then
        echo "ERROR: Invalid --mode value" >&2
        return 1
    fi

    return 0
}

# 校验 --config 路径
# Issue #3249: 使用 normalize_path 加固，拒绝相对路径
validate_config_path() {
    local path="${1:-}"
    local normalized

    # 拒绝相对路径
    if [[ "${path:0:1}" != "/" ]]; then
        echo "ERROR: Config path must be absolute" >&2
        return 1
    fi

    # 规范化路径
    normalized=$(normalize_path "$path") || {
        echo "ERROR: Config path not found" >&2
        return 1
    }

    # 校验规范化后的路径是否在白名单内
    # 缩短错误信息，避免路径泄露
    if [[ "$normalized" != "/etc/openace/config.json" ]] && \
       [[ ! "$normalized" =~ ^/home/[a-zA-Z0-9_-]+/\.open-ace/config\.json$ ]]; then
        echo "ERROR: Config path not allowed" >&2
        return 1
    fi

    return 0
}

# ============================================================================
# 路径规范化函数
# ============================================================================
# Issue #3249: 修复路径规范化 Bug，使用 readlink -f 或 realpath
# 平台支持：Linux (readlink -f 来自 GNU coreutils)
# 不支持平台：macOS (BSD readlink 不支持 -f)

normalize_path() {
    local path="$1"
    local normalized

    # 方法 1: 使用 readlink -f（推荐，Linux 标准工具）
    if command -v readlink >/dev/null 2>&1; then
        normalized=$(readlink -f "$path" 2>/dev/null) && {
            echo "$normalized"
            return 0
        }
    fi

    # 方法 2: 使用 realpath（GNU coreutils）
    if command -v realpath >/dev/null 2>&1; then
        normalized=$(realpath "$path" 2>/dev/null) && {
            echo "$normalized"
            return 0
        }
    fi

    # 无法规范化，返回失败
    return 1
}

# ============================================================================
# 【Issue #2543】符号链接攻击防护
# ============================================================================

# 路径白名单校验
# 只允许工具数据目录下的文件
is_allowed_path() {
    local path="$1"

    # 解析为绝对路径（使用 readlink -f 修复 Bug）
    local abs_path
    abs_path=$(normalize_path "$path") || return 1

    # 检查是否在允许的目录下
    # Linux: /home/<user>/.<tool>/...
    # macOS: /Users/<user>/.<tool>/...
    # 用户名字符集限制: [a-zA-Z0-9_-]（不支持 Unicode）
    for tool_dir in "${TOOL_TO_DIR[@]}"; do
        # Linux 路径
        if [[ "$abs_path" =~ ^/home/[a-zA-Z0-9_-]+/${tool_dir}/ ]]; then
            return 0
        fi
        # macOS 路径
        if [[ "$abs_path" =~ ^/Users/[a-zA-Z0-9_-]+/${tool_dir}/ ]]; then
            return 0
        fi
    done

    return 1
}

# 安全解析符号链接
# 返回最终路径，如果发现循环或超出深度限制则返回空
safe_resolve_symlink() {
    local target="$1"
    local depth=0
    local resolved="$target"
    local visited=()

    while [ -L "$resolved" ] && [ $depth -lt $MAX_SYMLINK_DEPTH ]; do
        # 获取符号链接指向的目标
        local link_target
        link_target=$(readlink "$resolved" 2>/dev/null) || return 1

        # 处理相对路径
        if [[ "$link_target" != /* ]]; then
            # 相对路径，相对于当前 resolved 的目录
            local base_dir
            base_dir=$(dirname "$resolved")
            link_target="${base_dir}/${link_target}"
        fi

        # 规范化路径（使用 normalize_path 修复 Bug）
        resolved=$(normalize_path "$link_target") || return 1

        # 检测循环
        for visited_path in "${visited[@]}"; do
            if [ "$resolved" = "$visited_path" ]; then
                echo "ERROR: Symlink loop detected" >&2
                return 1
            fi
        done

        # 记录已访问路径
        visited+=("$resolved")

        # 【关键安全检查】检查最终路径是否在白名单内
        # 如果符号链接指向白名单外的路径，拒绝访问
        if ! is_allowed_path "$resolved"; then
            echo "ERROR: Symlink target outside allowed directories" >&2
            return 1
        fi

        depth=$((depth + 1))
    done

    if [ $depth -ge $MAX_SYMLINK_DEPTH ]; then
        echo "ERROR: Symlink depth limit exceeded" >&2
        return 1
    fi

    echo "$resolved"
}

# 验证文件是否安全可读
# 检查符号链接、路径白名单、文件大小
validate_file() {
    local filepath="$1"

    # 检查文件是否存在
    if [ ! -e "$filepath" ]; then
        return 1
    fi

    # 解析符号链接
    local resolved_path="$filepath"
    if [ -L "$filepath" ]; then
        resolved_path=$(safe_resolve_symlink "$filepath") || {
            log_audit "symlink_rejected" "file=$(basename "$filepath") reason=outside_whitelist"
            return 1
        }
    else
        # 对于非符号链接，也需要验证路径
        if ! is_allowed_path "$filepath"; then
            echo "ERROR: Path not in allowlist: $filepath" >&2
            return 1
        fi
    fi

    # 检查文件大小
    local file_size
    file_size=$(stat -c%s "$resolved_path" 2>/dev/null || stat -f%z "$resolved_path" 2>/dev/null || echo "0")

    if [ "$file_size" -gt "$MAX_FILE_SIZE" ]; then
        local size_mb=$((file_size / 1024 / 1024))
        echo "WARNING: File too large (${size_mb}MB), skipping: $(basename "$filepath")" >&2
        log_audit "file_skipped" "file=$(basename "$filepath") size=${size_mb}MB reason=too_large"
        return 1
    fi

    return 0
}

# ============================================================================
# 参数验证
# Issue #3249: 重构参数验证，分离工具名与参数校验
# Issue #3249: 两阶段校验，先检测重复和格式，再检查路径存在性
# ============================================================================

# 验证参数是否符合允许的模式
# 使用两阶段验证：
# 1. 第一阶段：重复检测、格式校验（不依赖文件系统）
# 2. 第二阶段：路径存在性校验
validate_args() {
    # 检查参数不为空
    if [[ $# -eq 0 ]]; then
        echo "ERROR: No arguments provided" >&2
        return 1
    fi

    # 提取并校验工具名（第一个参数）
    local tool="${1:-}"
    validate_tool "$tool" || return 1
    shift

    # 关联数组跟踪已见参数（需要 bash 4.0+）
    local -A seen_params=()
    # 存储需要第二阶段校验的配置路径
    local config_path=""

    # ========================================
    # 第一阶段：重复检测和格式校验
    # ========================================
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --days)
                # 检测重复参数
                if [[ -n "${seen_params[--days]:-}" ]]; then
                    echo "ERROR: Duplicate parameter: --days" >&2
                    return 1
                fi
                seen_params[--days]=1

                # 参数值格式校验（不依赖文件系统）
                validate_arg_value "--days" "${2:-}" || return 1
                validate_days "$2" || return 1
                shift 2
                ;;
            --config)
                # 检测重复参数（优先于路径校验）
                if [[ -n "${seen_params[--config]:-}" ]]; then
                    echo "ERROR: Duplicate parameter: --config" >&2
                    return 1
                fi
                seen_params[--config]=1

                # 参数值格式校验（不依赖文件系统）
                validate_arg_value "--config" "${2:-}" || return 1

                # 记录配置路径，等待第二阶段校验
                config_path="${2:-}"
                shift 2
                ;;
            --mode)
                # Issue #3249: 新增 --mode 参数校验
                # 检测重复参数
                if [[ -n "${seen_params[--mode]:-}" ]]; then
                    echo "ERROR: Duplicate parameter: --mode" >&2
                    return 1
                fi
                seen_params[--mode]=1

                # 参数值校验
                validate_arg_value "--mode" "${2:-}" || return 1
                validate_mode "$2" || return 1
                shift 2
                ;;
            --multi-user|--recent)
                # 标志参数，无值
                shift
                ;;
            --)
                # 参数分隔符，停止解析
                break
                ;;
            *)
                echo "ERROR: Unknown argument: $1" >&2
                return 1
                ;;
        esac
    done

    # ========================================
    # 第二阶段：路径存在性校验
    # ========================================
    if [[ -n "$config_path" ]]; then
        validate_config_path "$config_path" || return 1
    fi

    return 0
}

# ============================================================================
# 主逻辑
# ============================================================================

main() {
    local args=("$@")

    # 检查参数
    if [ ${#args[@]} -eq 0 ]; then
        echo "Usage: $0 <tool> [args...]" >&2
        echo "Example: $0 fetch_qwen --days 1 --multi-user --recent --config ${DEFAULT_CONFIG}" >&2
        exit 1
    fi

    # 验证参数（包括工具名称）
    # Issue #3249: 使用参数分离验证
    validate_args "$@" || exit 1

    # 提取工具名称
    local tool_name="${args[0]}"

    # 记录审计日志 - 开始
    log_audit "fetch_start" "tool=${tool_name} args=${args[*]:1}"

    # 查找 Python 解释器
    local python_path
    python_path=$(which python3 2>/dev/null || which python 2>/dev/null || echo "python3")

    # 确定脚本路径
    local script_dir
    script_dir=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
    local script_path="${script_dir}/fetch_${tool_name#fetch_}.py"

    # 如果脚本不在同一目录，尝试项目目录
    if [ ! -f "$script_path" ]; then
        script_path="/opt/open-ace/scripts/fetch_${tool_name#fetch_}.py"
    fi

    if [ ! -f "$script_path" ]; then
        echo "ERROR: Script not found: $script_path" >&2
        log_audit "fetch_error" "tool=${tool_name} error=script_not_found"
        exit 1
    fi

    # 【Issue #2543 关键安全改进】
    # 使用 sudo -u 降权执行 fetch 脚本
    # root 可以读取所有用户目录，但 fetch 脚本以 openace 用户运行
    # 这样可以：
    # 1. 满足读取需求（root 权限）
    # 2. 限制写入权限（openace 用户）
    # 3. 遵循最小权限原则

    # 检查是否有 root 权限（通过 sudo 调用）
    local use_sudo_for_drop=""
    if [ "$(id -u)" -eq 0 ] && [ -n "$RUN_USER" ] && [ "$RUN_USER" != "root" ]; then
        # 当前是 root，需要降权到 openace
        use_sudo_for_drop="sudo -u $RUN_USER"
        log_audit "privilege_drop" "from=root to=$RUN_USER"
    fi

    # 执行 fetch 脚本
    # - 如果是 root 调用，降权到 openace 执行
    # - fetch 脚本内部会捕获 PermissionError 并处理
    local exit_code=0
    if [ -n "$use_sudo_for_drop" ]; then
        # 【降权执行】root 读取后，openace 写入数据库
        $use_sudo_for_drop "$python_path" "$script_path" "${args[@]:1}" || exit_code=$?
    else
        # 非特权模式，直接执行
        "$python_path" "$script_path" "${args[@]:1}" || exit_code=$?
    fi

    # 记录审计日志 - 结束
    log_audit "fetch_end" "tool=${tool_name} exit_code=${exit_code}"

    exit $exit_code
}

# 运行主函数
main "$@"
