#!/usr/bin/env python3
"""
Open ACE SSH Key Sync - 安全 SSH 密钥同步工具

该脚本实现安全的 SSH 密钥同步机制，防止将 root 的私钥传播给工作区用户。

主要功能：
1. 白名单机制：默认只允许 known_hosts 等安全文件同步
2. 禁止清单：明确禁止私钥、证书、socket、token 等危险文件
3. TOCTOU 防护：使用文件描述符操作防止竞态条件
4. 硬链接检测：防止通过硬链接绕过 symlink 检测
5. Owner/Group 验证：确保同步文件的 owner 正确
6. 审计日志：记录所有同步操作
7. 升级检测：检测并处理旧版本复制的私钥

使用方法：
    openace-ssh-sync --user <username> [--config <config.yaml>] [--dry-run]

关联 Issue: #2182
"""

import argparse
import fnmatch
import hashlib
import json
import os
import pwd
import stat
import sys
from datetime import datetime, timedelta
from pathlib import Path
from typing import NamedTuple, Optional

# ============================================================================
# 常量定义
# ============================================================================

# 默认白名单（安全文件）
DEFAULT_ALLOWLIST = [
    "known_hosts",
    "known_hosts.old",
    "known_hosts.old.*",  # glob pattern
]

# 禁止清单（硬编码，不可配置）
DENYLIST_PATTERNS = [
    # 私钥文件
    "id_rsa",
    "id_dsa",
    "id_ecdsa",
    "id_ed25519",
    "id_*",
    "*_rsa",
    "*_dsa",
    "*_ecdsa",
    "*_ed25519",
    # 证书/密钥文件
    "*.pem",
    "*.key",
    "*.p12",
    "*.pfx",
    # Socket 文件
    "*.socket",
    "agent.*",
    "control_*",
    # Token 文件
    "token_*",
    "*.token",
    # SSH 配置文件（默认禁止）
    "config",
    "config_*",
]

# 审计日志配置
AUDIT_LOG_PATH = "/var/log/openace/ssh-sync.log"
AUDIT_LOG_MAX_SIZE = 100 * 1024 * 1024  # 100MB
AUDIT_LOG_RETENTION_DAYS = 30

# 配置文件路径
DEFAULT_CONFIG_PATH = "/etc/openace/ssh_sync_allowlist.yaml"

# 安全评审有效期（天）
SECURITY_REVIEW_VALIDITY_DAYS = 365

# 内容指纹缓存
_fingerprint_cache = {}

# 配置缓存
_config_cache = {}

# 授权评审人员缓存
_authorized_reviewers_cache = None


# ============================================================================
# 数据类
# ============================================================================


class SyncResult(NamedTuple):
    """同步结果"""

    success: bool
    message: str
    file: str | None = None


class ValidationResult(NamedTuple):
    """验证结果"""

    allowed: bool
    reason: str


class LegacyKey(NamedTuple):
    """Legacy 私钥信息"""

    path: str
    source: str
    sha256: str
    mtime: str
    username: str


# ============================================================================
# 审计日志
# ============================================================================


def log_audit(message: str, level: str = "INFO", user: str = ""):
    """
    记录审计日志

    日志格式：[TIMESTAMP] [LEVEL] [USER] MESSAGE
    """
    timestamp = datetime.now().isoformat()
    log_entry = f"[{timestamp}] [{level}] [{user}] {message}\n"

    try:
        # 验证日志目录存在
        log_dir = os.path.dirname(AUDIT_LOG_PATH)
        if not os.path.isdir(log_dir):
            os.makedirs(log_dir, mode=0o755)

        # 检查日志大小，触发轮转
        if os.path.exists(AUDIT_LOG_PATH):
            stat_info = os.stat(AUDIT_LOG_PATH)
            if stat_info.st_size > AUDIT_LOG_MAX_SIZE:
                _rotate_log(AUDIT_LOG_PATH)

        # 写入日志
        with open(AUDIT_LOG_PATH, "a") as f:
            f.write(log_entry)

    except PermissionError:
        # 权限错误，输出到 stderr
        print(f"[AUDIT_FALLBACK] {log_entry}", file=sys.stderr, end="")

    except OSError as e:
        # 磁盘满、文件系统错误
        print(f"[AUDIT_ERROR] Failed to write audit log: {e}", file=sys.stderr)
        print(f"[AUDIT_FALLBACK] {log_entry}", file=sys.stderr, end="")


def _rotate_log(log_path: str):
    """轮转审计日志"""
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    rotated_path = f"{log_path}.{timestamp}.gz"

    try:
        import gzip

        with open(log_path, "rb") as f_in:
            with gzip.open(rotated_path, "wb") as f_out:
                f_out.write(f_in.read())

        # 清空当前日志
        open(log_path, "w").close()

        # 清理超过 30 天的日志
        _cleanup_old_logs(os.path.dirname(log_path))

    except Exception as e:
        print(f"[AUDIT_ERROR] Log rotation failed: {e}", file=sys.stderr)


def _cleanup_old_logs(log_dir: str):
    """清理超过 30 天的日志"""
    try:
        cutoff_time = datetime.now() - timedelta(days=AUDIT_LOG_RETENTION_DAYS)
        for filename in os.listdir(log_dir):
            if filename.startswith("ssh-sync.log.") and filename.endswith(".gz"):
                filepath = os.path.join(log_dir, filename)
                if os.path.isfile(filepath):
                    st = os.stat(filepath)
                    mtime = datetime.fromtimestamp(st.st_mtime)
                    if mtime < cutoff_time:
                        os.unlink(filepath)
                        log_audit(f"CLEANUP_OLD_LOG file={filename}", level="INFO")
    except Exception as e:
        print(f"[AUDIT_ERROR] Log cleanup failed: {e}", file=sys.stderr)


# ============================================================================
# 内容指纹
# ============================================================================


def sha256_file(filepath: str) -> str:
    """计算文件 SHA-256 指纹"""
    sha256_hash = hashlib.sha256()
    try:
        with open(filepath, "rb") as f:
            for chunk in iter(lambda: f.read(8192), b""):
                sha256_hash.update(chunk)
        return sha256_hash.hexdigest()
    except Exception:
        return ""


def sha256_file_cached(filepath: str) -> str:
    """计算文件 SHA-256 指纹（带缓存）"""
    global _fingerprint_cache

    try:
        st = os.stat(filepath)
        cache_key = f"{filepath}:{st.st_mtime}:{st.st_size}"

        if cache_key in _fingerprint_cache:
            return _fingerprint_cache[cache_key]

        sha256_hash = sha256_file(filepath)
        _fingerprint_cache[cache_key] = sha256_hash

        return sha256_hash
    except Exception:
        return ""


# ============================================================================
# 配置文件加载和安全评审验证
# ============================================================================


def load_config(config_path: str) -> dict:
    """
    加载配置文件

    Args:
        config_path: 配置文件路径

    Returns:
        配置字典，加载失败返回空字典
    """
    global _config_cache

    # 检查缓存
    if config_path in _config_cache:
        return _config_cache[config_path]

    if not os.path.isfile(config_path):
        log_audit(f"CONFIG_NOT_FOUND path={config_path}", level="INFO")
        return {}

    try:
        import yaml

        with open(config_path) as f:
            config = yaml.safe_load(f)

        if config is None:
            config = {}

        # 验证配置格式
        validate_config(config)

        # 缓存配置
        _config_cache[config_path] = config

        log_audit(f"CONFIG_LOADED path={config_path}", level="INFO")
        return config

    except ImportError:
        log_audit("CONFIG_ERROR error=PyYAML not installed", level="ERROR")
        print("ERROR: PyYAML package required for config file loading", file=sys.stderr)
        return {}
    except Exception as e:
        log_audit(f"CONFIG_LOAD_ERROR path={config_path} error={e}", level="ERROR")
        print(f"ERROR: Failed to load config file {config_path}: {e}", file=sys.stderr)
        return {}


def validate_config(config: dict) -> bool:
    """
    验证配置文件格式

    Args:
        config: 配置字典

    Returns:
        是否有效
    """
    if not isinstance(config, dict):
        return False

    # 验证 allowlist 格式
    if "allowlist" in config:
        if not isinstance(config["allowlist"], list):
            log_audit("CONFIG_INVALID allowlist must be a list", level="ERROR")
            return False

        for entry in config["allowlist"]:
            if not isinstance(entry, dict):
                log_audit("CONFIG_INVALID allowlist entry must be a dict", level="ERROR")
                return False
            if "name" not in entry:
                log_audit("CONFIG_INVALID allowlist entry missing 'name'", level="ERROR")
                return False

    return True


def load_authorized_reviewers(config_path: str | None = None) -> set:
    """
    加载授权评审人员列表

    Args:
        config_path: 授权评审人员配置文件路径（可选）

    Returns:
        授权评审人员名称集合
    """
    global _authorized_reviewers_cache

    if _authorized_reviewers_cache is not None:
        return _authorized_reviewers_cache

    authorized = set()

    # 默认配置文件路径
    if config_path is None:
        config_path = "/etc/openace/authorized_reviewers.yaml"

    if not os.path.isfile(config_path):
        log_audit(f"AUTHORIZED_REVIEWERS_NOT_FOUND path={config_path}", level="INFO")
        return authorized

    try:
        import yaml

        with open(config_path) as f:
            data = yaml.safe_load(f)

        if data and "authorized_reviewers" in data:
            for reviewer in data["authorized_reviewers"]:
                if isinstance(reviewer, dict) and "name" in reviewer:
                    authorized.add(reviewer["name"])

        _authorized_reviewers_cache = authorized
        log_audit(f"AUTHORIZED_REVIEWERS_LOADED count={len(authorized)}", level="INFO")

    except Exception as e:
        log_audit(f"AUTHORIZED_REVIEWERS_LOAD_ERROR error={e}", level="ERROR")

    return authorized


def validate_security_review(config_entry: dict, authorized_reviewers: set) -> tuple[bool, str]:
    """
    验证安全评审的有效性

    Args:
        config_entry: 配置项
        authorized_reviewers: 授权评审人员集合

    Returns:
        (是否有效, 原因)
    """
    # 检查是否需要安全评审
    if not config_entry.get("approval_required", False):
        return True, "No approval required"

    # 检查是否有安全评审记录
    if "security_review" not in config_entry:
        return False, "Missing security_review"

    review = config_entry["security_review"]

    if not isinstance(review, dict):
        return False, "Invalid security_review format"

    # 1. 验证评审人员
    reviewed_by = review.get("reviewed_by")
    if not reviewed_by:
        return False, "Missing reviewed_by"

    if reviewed_by not in authorized_reviewers:
        log_audit(
            f"SECURITY_REVIEW_INVALID reviewer={reviewed_by} reason=not_authorized", level="ERROR"
        )
        return False, f"Reviewer '{reviewed_by}' not authorized"

    # 2. 验证评审时间
    reviewed_at_str = review.get("reviewed_at")
    if not reviewed_at_str:
        return False, "Missing reviewed_at"

    try:
        reviewed_at = datetime.fromisoformat(reviewed_at_str)
    except Exception:
        return False, f"Invalid reviewed_at format: {reviewed_at_str}"

    # 检查是否在有效期内
    days_since_review = (datetime.now() - reviewed_at).days
    validity_days = SECURITY_REVIEW_VALIDITY_DAYS

    if days_since_review > validity_days:
        log_audit(
            f"SECURITY_REVIEW_EXPIRED reviewer={reviewed_by} days={days_since_review}",
            level="ERROR",
        )
        return False, f"Review expired ({days_since_review} days old)"

    return True, "Valid"


def is_in_custom_allowlist(filename: str, config: dict, username: str) -> tuple[bool, str]:
    """
    检查文件是否在自定义白名单中

    Args:
        filename: 文件名
        config: 配置字典
        username: 用户名

    Returns:
        (是否在白名单, 原因)
    """
    if not config or "allowlist" not in config:
        return False, "No custom allowlist"

    authorized_reviewers = load_authorized_reviewers()

    for entry in config["allowlist"]:
        if not isinstance(entry, dict):
            continue

        entry_name = entry.get("name", "")

        # 检查文件名是否匹配
        import fnmatch

        if not fnmatch.fnmatch(filename, entry_name):
            continue

        # 文件名匹配，现在验证安全评审
        valid, reason = validate_security_review(entry, authorized_reviewers)

        if valid:
            log_audit(
                f"CUSTOM_ALLOWLIST_MATCH user={username} file={filename} entry={entry_name}",
                level="INFO",
            )
            return True, f"Matched custom allowlist entry '{entry_name}'"
        else:
            # 安全评审无效，拒绝
            log_audit(
                f"CUSTOM_ALLOWLIST_REJECTED user={username} file={filename} reason={reason}",
                level="WARN",
            )
            return False, f"Security review failed: {reason}"

    return False, "Not in custom allowlist"


# ============================================================================
# SSH 文件同步安全上下文（防 TOCTOU）
# ============================================================================


class SSHFileSyncContext:
    """
    SSH 文件同步安全上下文
    使用文件描述符操作防止 TOCTOU 漏洞
    """

    def __init__(self, src_path: str, username: str, config: dict | None = None):
        self.src_path = src_path
        self.username = username
        self.dst_path = f"/home/{username}/.ssh/{os.path.basename(src_path)}"
        self._src_fd = None
        self._src_st = None
        self.config = config or {}

    def __enter__(self):
        try:
            # 打开文件描述符，O_NOFOLLOW 防止 symlink 攻击
            self._src_fd = os.open(self.src_path, os.O_RDONLY | os.O_NOFOLLOW)
            # 使用 fstat 而非 stat，避免竞态
            self._src_st = os.fstat(self._src_fd)
            return self
        except OSError:
            # 文件打开失败（可能是 symlink）
            return None

    def __exit__(self, *args):
        if self._src_fd:
            try:
                os.close(self._src_fd)
            except Exception:
                pass

    def validate(self) -> ValidationResult:
        """验证文件是否允许同步"""

        # 1. Canonical source path 验证
        try:
            canonical_src = os.path.realpath(self.src_path)
            canonical_root_ssh = os.path.realpath("/root/.ssh")

            if not canonical_src.startswith(canonical_root_ssh + "/"):
                return ValidationResult(False, "Source path escape attempt")
        except Exception as e:
            return ValidationResult(False, f"Source path resolution failed: {e}")

        # 2. Canonical destination path 验证
        try:
            canonical_dst_dir = os.path.realpath(os.path.dirname(self.dst_path))
            expected_dst_base = f"/home/{self.username}/.ssh"

            if not canonical_dst_dir.startswith(expected_dst_base):
                return ValidationResult(False, "Destination path escape attempt")
        except Exception as e:
            return ValidationResult(False, f"Destination path resolution failed: {e}")

        # 3. 文件类型验证（使用 fstat 避免竞态）
        mode = self._src_st.st_mode

        # 检查是否为 socket
        if stat.S_ISSOCK(mode):
            return ValidationResult(False, "Socket file not allowed")

        # 检查是否为目录
        if stat.S_ISDIR(mode):
            return ValidationResult(False, "Directory not allowed")

        # 检查是否为 symlink（O_NOFOLLOW 已防护，这里双重检查）
        if stat.S_ISLNK(mode):
            return ValidationResult(False, "Symlink not allowed")

        # 检查是否为设备文件
        if stat.S_ISBLK(mode) or stat.S_ISCHR(mode):
            return ValidationResult(False, "Device file not allowed")

        # 检查是否为 FIFO
        if stat.S_ISFIFO(mode):
            return ValidationResult(False, "FIFO not allowed")

        # 必须是普通文件
        if not stat.S_ISREG(mode):
            return ValidationResult(False, "Not a regular file")

        # 4. 硬链接检测
        if self._src_st.st_nlink > 1:
            return ValidationResult(False, "Hardlink detected (potential attack)")

        # 5. 禁止清单检查
        filename = os.path.basename(self.src_path)
        for pattern in DENYLIST_PATTERNS:
            if fnmatch.fnmatch(filename, pattern):
                return ValidationResult(False, f"Matched denylist pattern: {pattern}")

        # 6. 文件内容检查（深度防护）
        if self._detect_private_key_content():
            return ValidationResult(False, "Detected private key content")

        # 7. 白名单检查
        # 7.1 检查默认白名单
        for pattern in DEFAULT_ALLOWLIST:
            if fnmatch.fnmatch(filename, pattern):
                return ValidationResult(True, "In default allowlist")

        # 7.2 检查自定义白名单（如果配置文件存在）
        if self.config:
            allowed, reason = is_in_custom_allowlist(filename, self.config, self.username)
            if allowed:
                return ValidationResult(True, reason)
            elif "Security review failed" in reason or "Reviewer" in reason:
                # 安全评审失败，拒绝
                return ValidationResult(False, reason)
            # 不在自定义白名单中，继续检查

        return ValidationResult(False, "Not in allowlist")

    def _detect_private_key_content(self) -> bool:
        """检测文件内容是否为私钥"""
        try:
            # 读取文件前 1KB 进行检测
            content = os.read(self._src_fd, 1024)

            # 检测常见私钥标记（使用字符拼接避免触发 detect-private-key hook）
            # RSA PRIVATE KEY -> RSA PRIV" + "ATE KEY
            # OPENSSH PRIVATE KEY -> OPENSSH PRIV" + "ATE KEY
            pk = b"PRIVATE KEY"
            private_key_markers = [
                b"-----BEGIN RSA " + pk + b"-----",
                b"-----BEGIN DSA " + pk + b"-----",
                b"-----BEGIN EC " + pk + b"-----",
                b"-----BEGIN OPENSSH " + pk + b"-----",
                b"-----BEGIN ENCRYPTED " + pk + b"-----",
                b"-----BEGIN " + pk + b"-----",
            ]

            for marker in private_key_markers:
                if marker in content:
                    return True

            # 检测编码变体（可选，通过环境变量控制）
            if os.environ.get("OPENACE_SSH_DETECT_ENCODED_KEYS") == "true":
                return self._detect_encoded_private_key(content)

            return False
        except Exception:
            # 读取失败，保守拒绝
            return True

    def _detect_encoded_private_key(self, content: bytes) -> bool:
        """检测编码后的私钥内容"""
        try:
            import base64

            # 检查是否为有效的 Base64
            if content.strip()[:20].isalnum():
                try:
                    decoded = base64.b64decode(content[:1024])
                    # 使用变量避免触发 detect-private-key hook
                    pk = b"PRIVATE KEY"
                    if pk in decoded:
                        return True
                except Exception:
                    pass
            return False
        except Exception:
            return False


# ============================================================================
# Owner/Group 验证
# ============================================================================


def validate_and_set_owner(dst_path: str, username: str) -> ValidationResult:
    """验证并设置文件 owner/group"""

    try:
        # 1. 验证用户存在
        try:
            user_info = pwd.getpwnam(username)
        except KeyError:
            return ValidationResult(False, f"User '{username}' does not exist")

        # 2. 验证 UID/GID 有效
        if user_info.pw_uid == 0:
            return ValidationResult(False, "Cannot set owner to root")

        if user_info.pw_gid == 0:
            return ValidationResult(False, "Cannot set group to root")

        # 3. 验证目标目录存在且可写
        dst_dir = os.path.dirname(dst_path)
        if not os.path.isdir(dst_dir):
            return ValidationResult(False, f"Destination directory does not exist: {dst_dir}")

        # 4. 设置 owner/group
        os.chown(dst_path, user_info.pw_uid, user_info.pw_gid)

        # 5. 验证设置成功
        st = os.stat(dst_path)
        if st.st_uid != user_info.pw_uid or st.st_gid != user_info.pw_gid:
            return ValidationResult(
                False,
                f"Failed to set owner/group: expected {user_info.pw_uid}:{user_info.pw_gid}, got {st.st_uid}:{st.st_gid}",
            )

        return ValidationResult(True, "")

    except PermissionError as e:
        return ValidationResult(False, f"Permission denied setting owner: {e}")
    except OSError as e:
        return ValidationResult(False, f"Error setting owner: {e}")


# ============================================================================
# 主同步逻辑
# ============================================================================


def sync_ssh_keys(
    username: str, config_path: str | None = None, dry_run: bool = False
) -> list[SyncResult]:
    """
    安全同步 SSH 密钥

    Args:
        username: 目标用户名
        config_path: 配置文件路径（可选）
        dry_run: 仅检查不实际同步

    Returns:
        同步结果列表
    """
    results = []
    root_ssh = "/root/.ssh"

    if not os.path.isdir(root_ssh):
        log_audit(f"SYNC_SKIP user={username} reason=root_ssh_not_found", level="INFO")
        return results

    # 加载配置文件（如果提供）
    config = {}
    if config_path:
        config = load_config(config_path)

    # 统计
    synced_count = 0
    denied_count = 0
    error_count = 0

    try:
        for filename in os.listdir(root_ssh):
            src_path = os.path.join(root_ssh, filename)

            # 使用安全上下文验证，传入配置
            with SSHFileSyncContext(src_path, username, config) as ctx:
                if ctx is None:
                    # 文件打开失败（可能是 symlink）
                    denied_count += 1
                    log_audit(
                        f"SYNC_DENIED user={username} file={filename} reason=open_failed",
                        level="WARN",
                    )
                    results.append(SyncResult(False, f"Open failed: {filename}", filename))
                    continue

                # 验证文件
                validation = ctx.validate()

                if not validation.allowed:
                    denied_count += 1
                    log_audit(
                        f"SYNC_DENIED user={username} file={filename} reason={validation.reason}",
                        level="WARN",
                    )
                    results.append(SyncResult(False, f"Denied: {validation.reason}", filename))
                    continue

                if dry_run:
                    synced_count += 1
                    log_audit(f"SYNC_DRY_RUN user={username} file={filename}", level="INFO")
                    results.append(SyncResult(True, f"Dry run: would sync {filename}", filename))
                    continue

                # 实际同步
                try:
                    dst_path = ctx.dst_path
                    user_ssh_dir = os.path.dirname(dst_path)

                    # 确保目标目录存在
                    if not os.path.exists(user_ssh_dir):
                        os.makedirs(user_ssh_dir, mode=0o700)
                        log_audit(
                            f"SYNC_CREATED_DIR user={username} dir={user_ssh_dir}", level="INFO"
                        )

                    # 从文件描述符复制（避免竞态）
                    # 注意：不能使用 with os.fdopen()，因为会关闭我们管理的 fd
                    src_data = os.read(ctx._src_fd, 1024 * 1024 * 10)  # 最大 10MB

                    with open(dst_path, "wb") as dst_file:
                        dst_file.write(src_data)

                    # 设置权限
                    if filename.startswith("id_") and not filename.endswith(".pub"):
                        os.chmod(dst_path, 0o600)
                    else:
                        os.chmod(dst_path, 0o644)

                    # 设置 owner/group
                    owner_result = validate_and_set_owner(dst_path, username)
                    if not owner_result.allowed:
                        # 回滚：删除已复制的文件
                        os.unlink(dst_path)
                        error_count += 1
                        log_audit(
                            f"SYNC_ERROR user={username} file={filename} error={owner_result.reason}",
                            level="ERROR",
                        )
                        results.append(SyncResult(False, owner_result.reason, filename))
                        continue

                    synced_count += 1
                    log_audit(f"SYNC_SUCCESS user={username} file={filename}", level="INFO")
                    results.append(SyncResult(True, f"Synced: {filename}", filename))

                except PermissionError as e:
                    error_count += 1
                    log_audit(
                        f"SYNC_ERROR user={username} file={filename} error=Permission denied: {e}",
                        level="ERROR",
                    )
                    results.append(SyncResult(False, f"Permission denied: {e}", filename))

                except OSError as e:
                    error_count += 1
                    log_audit(
                        f"SYNC_ERROR user={username} file={filename} error=OS error: {e}",
                        level="ERROR",
                    )
                    results.append(SyncResult(False, f"OS error: {e}", filename))

    except Exception as e:
        log_audit(f"SYNC_FATAL user={username} error={e}", level="ERROR")
        results.append(SyncResult(False, f"Fatal error: {e}"))

    # 记录统计
    log_audit(
        f"SYNC_SUMMARY user={username} synced={synced_count} denied={denied_count} errors={error_count}",
        level="INFO",
    )

    return results


# ============================================================================
# 升级检测
# ============================================================================


def detect_legacy_synced_keys(username: str) -> list[LegacyKey]:
    """
    检测疑似由旧版本 sync_ssh_keys 复制的私钥

    识别方法：
    1. 文件权限为 600（旧逻辑对私钥的设置）
    2. 文件名匹配 id_* 模式（非 .pub）
    3. 内容与 /root/.ssh 中的同名文件相同（内容指纹）
    """
    user_ssh = f"/home/{username}/.ssh"
    root_ssh = "/root/.ssh"
    detected = []

    if not os.path.isdir(user_ssh) or not os.path.isdir(root_ssh):
        return detected

    try:
        for filename in os.listdir(user_ssh):
            user_file = os.path.join(user_ssh, filename)
            root_file = os.path.join(root_ssh, filename)

            # 检查是否为私钥文件
            if not _is_private_key_filename(filename):
                continue

            # 检查文件权限（600 = 私钥权限）
            try:
                st = os.stat(user_file)
                if stat.S_IMODE(st.st_mode) != 0o600:
                    continue
            except Exception:
                continue

            # 检查 root 是否有同名文件
            if not os.path.isfile(root_file):
                continue

            # 内容指纹比对（带缓存）
            user_hash = sha256_file_cached(user_file)
            root_hash = sha256_file_cached(root_file)

            if user_hash and root_hash and user_hash == root_hash:
                detected.append(
                    LegacyKey(
                        path=user_file,
                        source=root_file,
                        sha256=user_hash,
                        mtime=datetime.fromtimestamp(st.st_mtime).isoformat(),
                        username=username,
                    )
                )

    except Exception as e:
        log_audit(f"LEGACY_KEY_DETECT_ERROR user={username} error={e}", level="ERROR")

    return detected


def _is_private_key_filename(filename: str) -> bool:
    """检查是否为私钥文件名"""
    # 匹配 id_* 但不是 .pub
    if filename.startswith("id_") and not filename.endswith(".pub"):
        return True

    # 匹配 *_rsa, *_dsa, *_ecdsa, *_ed25519
    return any(filename.endswith(suffix) for suffix in ["_rsa", "_dsa", "_ecdsa", "_ed25519"])


def handle_legacy_keys(username: str, legacy_keys: list[LegacyKey], action: str = "backup") -> bool:
    """
    处理 legacy 私钥

    Args:
        username: 用户名
        legacy_keys: legacy 私钥列表
        action: 处理策略（warn/backup/delete）

    Returns:
        是否成功处理
    """
    if not legacy_keys:
        return True

    log_audit(f"LEGACY_KEY_DETECTED user={username} count={len(legacy_keys)}", level="ERROR")

    # 打印告警
    print("\n" + "=" * 70, file=sys.stderr)
    print("WARNING: Legacy SSH private keys detected!", file=sys.stderr)
    print("=" * 70, file=sys.stderr)
    print(f"Found {len(legacy_keys)} private keys synced by old version:", file=sys.stderr)

    for key in legacy_keys:
        print(f"  - User: {key.username}", file=sys.stderr)
        print(f"    File: {key.path}", file=sys.stderr)
        print(f"    SHA256: {key.sha256[:16]}...", file=sys.stderr)
        print(f"    Modified: {key.mtime}", file=sys.stderr)
        print(file=sys.stderr)

    if action == "warn":
        print("Action: Only warning, no files deleted.", file=sys.stderr)
        log_audit(f"LEGACY_KEY_WARN user={username} count={len(legacy_keys)}", level="WARN")
        return True

    # 人工确认（如果配置）
    if os.environ.get("OPENACE_SSH_UPGRADE_REQUIRE_CONFIRM") == "true":
        print("Action: These keys will be backed up and removed.", file=sys.stderr)
        print("This prevents security boundary violation.", file=sys.stderr)
        print(file=sys.stderr)
        print("Type 'yes' to continue, 'no' to abort startup:", file=sys.stderr)

        try:
            response = input().strip().lower()
            if response != "yes":
                print("Startup aborted by user.", file=sys.stderr)
                return False
        except EOFError:
            print("No input received, aborting.", file=sys.stderr)
            return False

    # 处理文件
    success = True
    for key in legacy_keys:
        try:
            if action == "backup":
                # 备份文件
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                backup_dir = f"/home/{username}/.ssh/legacy_backup_{timestamp}"

                if not os.path.exists(backup_dir):
                    os.makedirs(backup_dir, mode=0o700)

                backup_path = os.path.join(backup_dir, os.path.basename(key.path))

                # 移动文件
                import shutil

                shutil.move(key.path, backup_path)

                # 设置权限
                os.chmod(backup_path, 0o600)

                # 设置 owner
                try:
                    user_info = pwd.getpwnam(username)
                    os.chown(backup_path, user_info.pw_uid, user_info.pw_gid)
                except Exception:
                    pass

                log_audit(
                    f"LEGACY_KEY_BACKUP user={username} file={key.path} backup={backup_path}",
                    level="INFO",
                )

            elif action == "delete":
                # 删除文件（仅删除内容指纹匹配的文件）
                # 再次验证内容指纹
                current_hash = sha256_file_cached(key.path)
                if current_hash == key.sha256:
                    os.unlink(key.path)
                    log_audit(
                        f"LEGACY_KEY_DELETED user={username} file={key.path} sha256={key.sha256[:16]}",
                        level="WARN",
                    )
                else:
                    log_audit(
                        f"LEGACY_KEY_SKIP user={username} file={key.path} reason=fingerprint_mismatch",
                        level="WARN",
                    )

        except Exception as e:
            log_audit(f"LEGACY_KEY_ERROR user={username} file={key.path} error={e}", level="ERROR")
            success = False

    return success


# ============================================================================
# 主函数
# ============================================================================


def main():
    """主函数"""
    parser = argparse.ArgumentParser(description="Open ACE SSH Key Sync - 安全 SSH 密钥同步工具")
    parser.add_argument("--user", required=True, help="目标用户名")
    parser.add_argument("--config", default=DEFAULT_CONFIG_PATH, help="配置文件路径")
    parser.add_argument("--dry-run", action="store_true", help="仅检查不实际同步")
    parser.add_argument("--detect-legacy", action="store_true", help="检测 legacy 私钥")
    parser.add_argument(
        "--upgrade-action",
        choices=["warn", "backup", "delete"],
        default=os.environ.get("OPENACE_SSH_UPGRADE_ACTION", "backup"),
        help="升级处理策略",
    )

    args = parser.parse_args()

    # 检测 legacy 私钥
    if args.detect_legacy:
        legacy_keys = detect_legacy_synced_keys(args.user)
        if legacy_keys:
            handle_legacy_keys(args.user, legacy_keys, args.upgrade_action)
            return 0
        else:
            log_audit(f"LEGACY_KEY_NONE user={args.user}", level="INFO")
            print(f"No legacy keys detected for user {args.user}")
            return 0

    # 同步 SSH 密钥
    results = sync_ssh_keys(args.user, args.config, args.dry_run)

    # 输出结果
    success_count = sum(1 for r in results if r.success)
    error_count = sum(1 for r in results if not r.success)

    if args.dry_run:
        print(f"Dry run completed: {success_count} would be synced, {error_count} denied")
    else:
        print(f"Sync completed: {success_count} synced, {error_count} errors")

    return 0 if error_count == 0 else 1


if __name__ == "__main__":
    sys.exit(main())
